      },
      "body-on-dark": {
        "value": "{neutral.gray-3}",
        "job": "paragraph text in the footer; never pure white"
      },
      "muted": {
        "value": "{neutral.gray-4}",
        "job": "captions, labels, placeholders, help text"
      },
      "primary": {
        "value": "{brand.rose}",
