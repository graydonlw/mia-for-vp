.DS_Store
node_modules/

# Fetched or generated binary payload is re-creatable; keep manifests, drop the files.
# Photographs are the exception: the web-sized derivatives here are the only copies
# in the repo, the originals live outside it, and the site 404s its own images without them.
assets/*
!assets/*.json
!assets/*.md
!assets/*.webp
!assets/*.jpg
!assets/*.png
!assets/*.svg

# The QR codes are generated, but they are campaign collateral that has to be
# printable from a fresh clone. `assets/*` excludes this directory outright, so
# the file negations above can never reach inside it — un-exclude the directory.
!assets/qr/
